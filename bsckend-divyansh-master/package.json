{
  "name": "mutton",
  "module": "src/index.ts",
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@types/bun": "latest",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^6.4.17",
    "globals": "^16.1.0",
    "husky": "^9.1.7",
    "typescript-eslint": "^8.32.0"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "bunx eslint --fix",
      "bunx prettier --write"
    ]
  },
  "scripts": {
    "dev": "bun --hot --env-file=.env.local run src/index.ts",
    "compile": "bun build --compile --minify --sourcemap src/index.ts --outfile ./build/mutton",
    "start": "./build/mutton",
    "clean": "rm -rf ./build",
    "prepare": "husky"
  },
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.955.0",
    "@aws-sdk/client-ses": "^3.955.0",
    "@aws-sdk/client-sqs": "^3.953.0",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.1",
    "@types/multer": "^2.0.0",
    "@types/request-ip": "^0.0.41",
    "@types/uuid": "^11.0.0",
    "axios": "^1.13.2",
    "body-parser": "^2.2.0",
    "cors": "^2.8.5",
    "dayjs": "^1.11.19",
    "express": "^5.1.0",
    "google-auth-library": "^10.5.0",
    "jsonwebtoken": "^9.0.3",
    "livekit-server-sdk": "^2.15.0",
    "mongoose": "^8.14.2",
    "multer": "^2.0.2",
    "nodemailer": "^6.9.16",
    "officeparser": "^5.2.2",
    "openai": "^6.14.0",
    "request-ip": "^3.3.0",
    "sqs-consumer": "^14.2.0",
    "sqs-producer": "^8.0.1",
    "uuid": "^13.0.0",
    "winston": "^3.17.0"
  }
}
