                      "    if (response.data && response.data.tokens) {",
                      "        pm.collectionVariables.set('dashboard_access_token', response.data.tokens.access_token);",
                      "        pm.collectionVariables.set('dashboard_refresh_token', response.data.tokens.refresh_token);",
