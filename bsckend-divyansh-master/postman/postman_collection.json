                  "mode": "raw",
                  "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"securepassword123\",\n  \"organization_id\": \"{{organization_id}}\",\n  \"first_name\": \"John\",\n  \"last_name\": \"Doe\"\n}"
