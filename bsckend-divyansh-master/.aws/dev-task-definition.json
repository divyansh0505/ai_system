{
  "containerDefinitions": [
    {
      "name": "chicken-dev",
      "image": "789501570539.dkr.ecr.us-east-1.amazonaws.com/development/chicken-dev:latest",
      "cpu": 0,
      "portMappings": [
        {
          "appProtocol": "http",
          "containerPort": 8000,
          "hostPort": 8000,
          "name": "chicken-dev-8000-tcp",
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "environment": [],
      "environmentFiles": [],
      "systemControls": [],
      "ulimits": [],
      "volumesFrom": [],
      "mountPoints": [],
      "logConfiguration": {
        "logDriver": "awsfirelens"
      }
    },
    {
      "name": "log_router",
      "image": "betterstack/aws-ecs-fluent-bit:amd64-latest",
      "cpu": 256,
      "memory": 512,
      "memoryReservation": 50,
      "essential": true,
      "environment": [
        {
          "name": "LOGTAIL_SOURCE_TOKEN",
          "value": "fjPeJRwffiKHJn13QKYGmcEA"
        },
        {
          "name": "BETTER_STACK_INGESTING_HOST",
          "value": "s1602876.us-east-9.betterstackdata.com"
        }
      ],
      "firelensConfiguration": {
        "type": "fluentbit",
        "options": {
          "config-file-type": "file",
          "config-file-value": "/fluent-bit-logtail.conf",
          "enable-ecs-log-metadata": "true"
        }
      }
    }
  ],
  "cpu": "1024",
  "executionRoleArn": "arn:aws:iam::789501570539:role/ecs-task-execution-role",
  "family": "chicken-dev",
  "memory": "3072",
  "networkMode": "awsvpc",
  "placementConstraints": [],
  "requiresCompatibilities": ["FARGATE"],
  "revision": 1,
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "taskRoleArn": "arn:aws:iam::789501570539:role/ecs-task-chicken-dev",
  "volumes": [],
  "tags": []
}
