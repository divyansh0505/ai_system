{
  "containerDefinitions": [
    {
      "name": "chicken-prod",
      "image": "789501570539.dkr.ecr.us-east-1.amazonaws.com/production/chicken-prod:latest",
      "cpu": 0,
      "portMappings": [
        {
          "appProtocol": "http",
          "containerPort": 8000,
          "hostPort": 8000,
          "name": "chicken-prod-8000-tcp",
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "environment": [],
      "environmentFiles": [],
      "mountPoints": [],
      "systemControls": [],
      "ulimits": [],
      "logConfiguration": {
        "logDriver": "awsfirelens"
      },
      "volumesFrom": []
    },
    {
      "name": "log_router",
      "image": "betterstack/aws-ecs-fluent-bit:amd64-latest",
      "cpu": 256,
      "memory": 512,
      "memoryReservation": 50,
      "essential": true,
      "environment": [
        {
          "name": "LOGTAIL_SOURCE_TOKEN",
          "value": "4RYPTCsHxePDWh7PvFw5dqiP"
        },
        {
          "name": "BETTER_STACK_INGESTING_HOST",
          "value": "s1562554.us-east-9.betterstackdata.com"
        }
      ],
      "firelensConfiguration": {
        "type": "fluentbit",
        "options": {
          "config-file-type": "file",
          "config-file-value": "/fluent-bit-logtail.conf",
          "enable-ecs-log-metadata": "true"
        }
      }
    }
  ],
  "cpu": "2048",
  "executionRoleArn": "arn:aws:iam::789501570539:role/ecs-task-execution-role",
  "family": "chicken-prod",
  "memory": "4096",
  "networkMode": "awsvpc",
  "placementConstraints": [],
  "requiresCompatibilities": ["FARGATE"],
  "revision": 1,
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "taskRoleArn": "arn:aws:iam::789501570539:role/ecs-task-chicken-prod",
  "volumes": [],
  "tags": [
    {
      "key": "env",
      "value": "production"
    }
  ]
}
